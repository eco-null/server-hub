# Server Hub configuration. Copy to .env and edit.
# Every variable is read at startup; invalid values stop the server with a
# message naming the variable. Unknown SERVERHUB_* names are ignored silently,
# so check spelling. Lines starting with "# SERVERHUB_" show the default.
# Booleans accept true/false (also 1/0, yes/no, on/off).

# REQUIRED. At least 32 characters. Generate one with:
#   openssl rand -hex 24
# or, on a machine without openssl:
#   python -c "import secrets; print(secrets.token_hex(24))"
# (both print 48 characters).
#
# What it protects: 2FA (TOTP) secrets, recovery-code hashes and stored Beszel
# passwords are encrypted / keyed with sub-keys derived from it. Passwords
# (argon2id) and sessions do NOT depend on it.
#
# If you change or lose it:
#   - everyone keeps their password; sessions stay valid;
#   - every account with 2FA can no longer complete sign-in (the stored TOTP
#     secret and recovery codes become unreadable). Recover each one with
#       docker compose exec server-hub python -m serverhub reset-password --user NAME --disable-2fa
#     (sets a new password, turns 2FA off, revokes sessions), then re-enrol 2FA;
#     an admin can also clear another user's 2FA (admin user management,
#     PATCH /api/admin/users/{id} {"disable_twofa": true});
#   - Beszel instances report "Stored password cannot be decrypted": re-enter
#     their passwords in the Beszel settings.
# Keep a copy of this value with your backups.
SERVERHUB_SECRET_KEY=

# Host port published by compose.yaml (the container always listens on 8642).
# Read by Docker Compose only, not by the app.
SERVERHUB_PUBLISH_PORT=8642

# Where the SQLite database lives, and the address and port the server listens
# on (port 1-65535). The values below are the defaults for running without
# Docker. compose.yaml fixes all three inside the container (/data, 0.0.0.0,
# 8642) and its values win over this file, so setting them here has no effect
# under Compose; use SERVERHUB_PUBLISH_PORT to change the published port.
# SERVERHUB_DATA_DIR=./data
# SERVERHUB_HOST=0.0.0.0
# SERVERHUB_PORT=8642

# ---- First-run setup ------------------------------------------------------------
# Creating the first admin in the web UI needs a setup token, so nobody else on
# the network can claim a fresh install. If unset, a random token is generated
# at every start while no account exists and printed in the startup log:
#   docker compose logs server-hub
# Set it here (16+ characters) to choose your own. Ignored once an account exists.
# The CLI needs no token:  python -m serverhub create-admin --email ... --username ...
# SERVERHUB_SETUP_TOKEN=

# ---- Host names ---------------------------------------------------------------------
# Requests are only answered for these Host names (protection against DNS
# rebinding). IP addresses and "localhost" are always accepted. Any other name
# you use in the browser (e.g. hub.lan, dash.example.org) must be listed here
# (comma-separated, names only, no scheme or port) or be the host of
# SERVERHUB_PUBLIC_URL; otherwise the server answers "400 Host ... is not allowed".
# SERVERHUB_ALLOWED_HOSTS=hub.lan

# Public URL users type in the browser, e.g. https://hub.example.org:8642
# Optional. Its host is allowed (see above), it is accepted as Origin for the
# CSRF check and, if https, Secure / __Host- cookies are used.
# SERVERHUB_PUBLIC_URL=

# ---- TLS (recommended unless only reachable via a trusted LAN / VPN / tunnel) --------
# There is no reverse proxy: the app terminates TLS itself. Both variables must
# be set together and both files must exist, or the server refuses to start.
# With Docker, do NOT edit compose.yaml: create a compose.override.yaml (ignored
# by Git) that mounts ./certs read-only and sets these two variables; a
# copy-paste example is in docs/DEPLOYMENT.md ("TLS"). The files are PEM: the
# certificate with its full chain, and the private key, which must be readable
# by uid 10001 (the container user). Use certificates from your own CA, Let's
# Encrypt (DNS challenge) or e.g. `tailscale cert`. Restart after renewing.
# Without TLS the server logs a warning when listening on a non-loopback address.
# Outside Docker, point them at the files directly.
# SERVERHUB_TLS_CERT_FILE=/certs/fullchain.pem
# SERVERHUB_TLS_KEY_FILE=/certs/privkey.pem

# Cookie Secure flag: auto | true | false.
# auto = Secure + "__Host-" cookie prefix when TLS is on or SERVERHUB_PUBLIC_URL is https.
# Browsers drop Secure cookies on plain http:// pages, so if you force this on
# (or set an https PUBLIC_URL) and still open the hub over http://, sign-in
# silently loops back to the login page; the server warns about this at startup.
# SERVERHUB_COOKIE_SECURE=auto

# Comma-separated CIDRs of proxies / tunnel endpoints whose X-Forwarded-For /
# -Proto headers are trusted. Empty (default) = client IP is the TCP peer.
# SERVERHUB_TRUSTED_PROXIES=

# ---- Connection limits (slow-client protection) -----------------------------------
# The server drops connections that do not send a complete request head within
# 10 s, stall a request body for 10 s, or take longer than 120 s to send one.
# These cap open connections overall (16-100000) and per client address
# (2-10000; IPv6 per /64; loopback and trusted proxies are exempt from the
# per-address cap).
# SERVERHUB_MAX_CONNECTIONS=512
# SERVERHUB_MAX_CONNECTIONS_PER_IP=32

# Status checks and Beszel may contact RFC 1918 / ULA / CGNAT addresses
# (10/8, 172.16/12, 192.168/16, 100.64/10, fc00::/7). On by default because a
# homelab dashboard targets LAN services. Set false on an internet-facing
# instance with open registration. Loopback, link-local / cloud-metadata,
# multicast and reserved ranges are ALWAYS blocked regardless.
# SERVERHUB_ALLOW_PRIVATE_NETWORK_TARGETS=true

# Sessions expire after this many idle days, and after SESSION_MAX_DAYS regardless.
# Days may be fractional (e.g. 0.5); each must be > 0 and <= 365, and MAX_DAYS
# must be >= IDLE_DAYS. At most 20 sessions per user are kept (the oldest is
# signed out first).
# SERVERHUB_SESSION_IDLE_DAYS=7
# SERVERHUB_SESSION_MAX_DAYS=30

# Log verbosity. One of: critical | error | warning | info | debug
#   info (default)  start-up line ("listening on ..."), database migrations,
#                   warnings and errors.
#   warning         warnings and errors only. The lowest level that still shows
#                   the first-run setup token and the configuration warnings.
#   error, critical  hide the setup token and the warnings; avoid them unless
#                   you set SERVERHUB_SETUP_TOKEN yourself.
#   debug           everything above plus an access log line for every request
#                   (method and path) and verbose output from the HTTP
#                   libraries. Noisy: for troubleshooting only.
# SERVERHUB_LOG_LEVEL=info

# ---- Development only ------------------------------------------------------------
# Directory with the frontend files (served from disk, read on every request).
# Defaults to the web/ folder next to the serverhub/ package, which is also
# where the Docker image keeps it: leave it unset in Docker.
# SERVERHUB_WEB_DIR=./web
